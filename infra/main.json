  "outputs": {
    "acrLoginServer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-11-01-preview').loginServer]"
    },
    "acrName": {
      "type": "string",
      "value": "[variables('acrName')]"
    },
    "AZURE_CONTAINER_REGISTRY_ENDPOINT": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-11-01-preview').loginServer]"
    },
    "openAiEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('openAiName')), '2025-06-01').endpoint]"
    },
    "openAiDeployment": {
      "type": "string",
      "value": "gpt-5-mini"
    },
    "foundryProjectEndpoint": {
      "type": "string",
      "value": "[variables('foundryProjectEndpoint')]"
    },
    "acaEnvironmentName": {
      "type": "string",
      "value": "[variables('acaEnvName')]"
    },
    "orchestratorAppName": {
      "type": "string",
      "value": "[variables('orchestratorAppName')]"
    },
    "orchestratorFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', variables('orchestratorAppName')), '2024-03-01').configuration.ingress.fqdn]"
    },
    "orchestratorUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('orchestratorAppName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "orchestratorPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('orchestratorUamiName')), '2023-01-31').principalId]"
    },
    "sandboxGroupName": {
      "type": "string",
      "value": "[variables('sandboxGroupName')]"
    },
    "sandboxGroupId": {
      "type": "string",
      "value": "[resourceId('Microsoft.App/sandboxGroups', variables('sandboxGroupName'))]"
    },
    "sandboxGroupUamiClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('sandboxGroupUamiName')), '2023-01-31').clientId]"
    },
    "resourceGroupName": {
      "type": "string",
      "value": "[resourceGroup().name]"
    },
    "subscriptionId": {
      "type": "string",
      "value": "[subscription().subscriptionId]"
    },
    "applicationInsightsName": {
      "type": "string",
      "value": "[variables('appInsightsName')]"
    },
    "applicationInsightsConnectionString": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').ConnectionString]"
