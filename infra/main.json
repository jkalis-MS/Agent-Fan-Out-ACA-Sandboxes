              "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-11-01-preview').loginServer]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('orchestratorUamiName'))]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "orchestrator",
              "image": "[if(not(empty(parameters('orchestratorImage'))), parameters('orchestratorImage'), variables('quickstartImage'))]",
              "resources": {
                "cpu": "[json('1.0')]",
                "memory": "2Gi"
              },
              "env": [
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('orchestratorUamiName')), '2023-01-31').clientId]"
                },
                {
                  "name": "AZURE_OPENAI_ENDPOINT",
                  "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('openAiName')), '2025-06-01').endpoint]"
                },
                {
                  "name": "AZURE_OPENAI_DEPLOYMENT",
                  "value": "gpt-5-mini"
                },
                {
                  "name": "FOUNDRY_PROJECT_ENDPOINT",
                  "value": "[variables('foundryProjectEndpoint')]"
                },
                {
                  "name": "SUBSCRIPTION_ID",
                  "value": "[subscription().subscriptionId]"
                },
                {
                  "name": "RESOURCE_GROUP",
                  "value": "[resourceGroup().name]"
                },
                {
                  "name": "SANDBOX_GROUP",
                  "value": "[variables('sandboxGroupName')]"
                },
                {
                  "name": "SANDBOX_GROUP_UAMI_CLIENT_ID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('sandboxGroupUamiName')), '2023-01-31').clientId]"
                },
                {
                  "name": "DEFAULT_REGION",
                  "value": "[parameters('location')]"
                },
                {
                  "name": "ACR_LOGIN_SERVER",
                  "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-11-01-preview').loginServer]"
                },
                {
                  "name": "DISK_IMAGE_ID",
                  "value": "[if(not(empty(parameters('researchAgentImage'))), parameters('researchAgentImage'), format('{0}/research-agent:latest', reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-11-01-preview').loginServer))]"
