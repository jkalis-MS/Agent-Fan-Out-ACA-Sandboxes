{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "3050433265902243267"
    }
  },
  "parameters": {
    "prefix": {
      "type": "string",
      "defaultValue": "aca-sandboxes-agents",
      "metadata": {
        "description": "Base name prefix for all resources"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for deployment"
      }
    },
    "openAiLocation": {
      "type": "string",
      "defaultValue": "westus",
      "metadata": {
        "description": "Azure region for the Azure OpenAI account. Defaults to westus; choose a region that supports gpt-5-mini."
      }
    },
    "gpt5MiniModelVersion": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "gpt-5-mini model version. Leave empty to use the regional default version."
      }
    },
    "gpt5MiniCapacity": {
      "type": "int",
      "defaultValue": 50,
      "metadata": {
        "description": "gpt-5-mini deployment capacity (TPM in thousands). 6 parallel researchers plus reasoning tokens; 50 gives safe headroom."
      }
    },
    "orchestratorImage": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Container image for the orchestrator. Pass empty on first deploy; update after pushing the image. AZD/setup.sh sets this automatically."
      }
    },
    "researchAgentImage": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Container image for the research agent (used at runtime by sandboxes). Pass empty on first deploy."
      }
    },
    "azdServiceName": {
      "type": "string",
      "defaultValue": "orchestrator",
      "metadata": {
        "description": "Tag value used by `azd` to associate this resource with the deployed service. Leave default unless you customize azure.yaml."
      }
    },
    "azdEnvName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Tag value used by `azd` to identify the environment."
      }
    },
    "acrSku": {
      "type": "string",
      "defaultValue": "Basic",
      "allowedValues": [
        "Basic",
        "Standard",
        "Premium"
      ],
      "metadata": {
        "description": "ACR SKU"
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[uniqueString(resourceGroup().id)]",
    "acrName": "[replace(format('{0}acr{1}', parameters('prefix'), variables('uniqueSuffix')), '-', '')]",
    "openAiName": "[format('{0}-openai-{1}', parameters('prefix'), variables('uniqueSuffix'))]",
    "aiProjectName": "[format('{0}-proj', parameters('prefix'))]",
    "logAnalyticsName": "[format('{0}-logs-{1}', parameters('prefix'), variables('uniqueSuffix'))]",
    "appInsightsName": "[format('{0}-appi-{1}', parameters('prefix'), variables('uniqueSuffix'))]",
    "acaEnvName": "[format('{0}-env', parameters('prefix'))]",
    "orchestratorAppName": "[format('{0}-orch', parameters('prefix'))]",
    "sandboxGroupName": "[format('{0}-sg-{1}', parameters('prefix'), parameters('location'))]",
    "orchestratorUamiName": "[format('{0}-orch-uami', parameters('prefix'))]",
    "sandboxGroupUamiName": "[format('{0}-sg-uami', parameters('prefix'))]",
    "acrPullRoleId": "7f951dda-4ed3-4680-a7ca-43fe172d538d",
    "cognitiveServicesOpenAIUserId": "5e0bd9bd-7b93-4f28-af87-19fc36ad61bd",
    "foundryUserRoleId": "53ca6127-db72-4b80-b1b0-d745d6d5456d",
    "sandboxGroupDataOwnerRoleId": "c24cf47c-5077-412d-a19c-45202126392c",
    "sandboxGroupResourceId": "[resourceId('Microsoft.App/sandboxGroups', variables('sandboxGroupName'))]",
    "quickstartImage": "mcr.microsoft.com/k8se/quickstart:latest",
    "foundryProjectEndpoint": "[format('https://{0}.services.ai.azure.com/api/projects/{1}', variables('openAiName'), variables('aiProjectName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('orchestratorUamiName')]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('sandboxGroupUamiName')]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('logAnalyticsName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
